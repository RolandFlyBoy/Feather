{% extends "pages/admin/base.html" %}

{% block admin_title %}Tools{% endblock %}

{% block admin_content %}
<div class="space-y-6">

    <h2 class="text-2xl font-bold">Tools</h2>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

    <!-- Email Card -->
    <div class="admin-card">
        <div class="p-6 border-b border-line">
            <div class="flex items-center gap-3">
                <div class="admin-card-icon">
                    <span class="material-symbols-outlined">mail</span>
                </div>
                <div>
                    <h3 class="text-lg font-semibold">Send Email</h3>
                    <p class="text-sm text-ink-2">Send an email to a user</p>
                </div>
            </div>
        </div>
        <div class="p-6">
            <form hx-post="{{ url_for('admin.send_email') }}"
                  hx-target="#email-result"
                  hx-swap="innerHTML"
                  class="space-y-4">

                <div>
                    <label class="block text-sm font-medium text-ink-2 mb-1">Recipient</label>
                    <input type="text"
                           id="email-to-input"
                           name="to"
                           placeholder="Search users or enter email..."
                           hx-get="{{ url_for('admin.search_users_dropdown') }}"
                           hx-trigger="input changed delay:300ms"
                           hx-target="#user-dropdown"
                           class="w-full px-3 py-2 border border-line rounded-lg focus:ring-2 focus:ring-accent focus:border-accent">
                    <div id="user-dropdown" class="relative"></div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-ink-2 mb-1">Subject</label>
                    <input type="text"
                           name="subject"
                           required
                           class="w-full px-3 py-2 border border-line rounded-lg focus:ring-2 focus:ring-accent focus:border-accent">
                </div>

                <div>
                    <label class="block text-sm font-medium text-ink-2 mb-1">Message</label>
                    <textarea name="body"
                              rows="6"
                              required
                              class="w-full px-3 py-2 border border-line rounded-lg focus:ring-2 focus:ring-accent focus:border-accent"></textarea>
                </div>

                <div class="flex justify-end">
                    <button type="submit"
                            class="admin-btn admin-btn-primary">
                        Send Email
                    </button>
                </div>
            </form>
            <div id="email-result" class="mt-4"></div>
        </div>
    </div>

    </div>

</div>
{% endblock %}
