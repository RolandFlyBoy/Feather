@import "tailwindcss";

/* Feather's UI foundation: design tokens and the components built on them.
   Edit the tokens there to set the look of this app. */
@import "./ui.css";

/* Scan Feather's own component templates for Tailwind classes.
   .feather-templates is a symlink to the installed package's
   templates (refreshed by `feather dev` / `feather build`) and a
   real directory inside the Docker image. */
@source "../../.feather-templates/**/*.html";

/* Scan this project's templates (relative, so it builds anywhere) */
@source "../../templates/**/*.html";

/* Dark mode — manual toggle via .dark class on <html> */
@custom-variant dark (&:where(.dark, .dark *));

/* Sensible defaults */
@layer base {
  /* Interactive elements get pointer cursor */
  button, [role="button"], [type="submit"], [type="button"] {
    cursor: pointer;
  }

  a {
    cursor: pointer;
  }

  /* Disabled elements */
  button:disabled, [disabled] {
    cursor: not-allowed;
    opacity: 0.5;
  }
}


/* Material Icons - use: <span class="icon">home</span> */
@layer components {
  .icon {
    font-family: 'Material Symbols Outlined';
    font-weight: normal;
    font-style: normal;
    font-size: 24px;
    line-height: 1;
    letter-spacing: normal;
    text-transform: none;
    display: inline-block;
    white-space: nowrap;
    word-wrap: normal;
    direction: ltr;
    -webkit-font-smoothing: antialiased;
    vertical-align: middle;
  }

  /* Icon sizes */
  .icon-sm { font-size: 18px; }
  .icon-md { font-size: 24px; }
  .icon-lg { font-size: 36px; }
  .icon-xl { font-size: 48px; }

  /* Drag and drop styles */
  .dragging {
    opacity: 0.5;
  }

  .drag-over {
    background-color: rgba(59, 130, 246, 0.1);
  }

  .feather-drop-placeholder {
    height: 2px;
    background: #3b82f6;
    border-radius: 2px;
    margin: 4px 0;
  }

  /* Admin Panel Styles — Sidebar Layout
     Built on the design tokens in ui.css (bg, surface, ink, line, accent), so
     the admin takes the app's own look and its dark mode follows the tokens. */

  /* App Shell */
  .app-shell {
    @apply min-h-screen bg-bg text-ink;
  }

  /* Desktop Sidebar */
  .desktop-sidebar {
    @apply hidden lg:fixed lg:inset-y-0 lg:z-50 lg:flex lg:w-72 lg:flex-col;
  }

  .sidebar-inner {
    @apply flex grow flex-col gap-y-5 overflow-y-auto border-r border-line bg-surface px-5;
  }

  .sidebar-logo {
    @apply flex h-16 shrink-0 items-center gap-3 no-underline;
  }

  .sidebar-logo-icon {
    @apply h-8 w-8 text-accent;
  }

  .sidebar-logo-text {
    @apply font-display font-semibold text-ink tracking-tight leading-tight;
  }

  .sidebar-logo-text-group {
    @apply flex flex-col;
  }

  .sidebar-logo-subtitle {
    @apply text-xs font-medium uppercase tracking-[0.08em] text-ink-3;
  }

  .sidebar-nav {
    @apply flex flex-1 flex-col;
  }

  .sidebar-nav-list {
    @apply flex flex-1 flex-col gap-y-4;
  }

  .sidebar-nav-section {
    @apply -mx-1 space-y-0.5;
  }

  .sidebar-nav-item {
    @apply flex items-center gap-x-3 rounded-ui px-2.5 min-h-10 text-sm font-medium text-ink-2 no-underline transition-colors duration-150;
    @apply hover:bg-surface-2 hover:text-ink;
  }

  .sidebar-nav-item.active {
    @apply bg-accent-soft text-ink;
  }

  /* Icons in the ink, not a pale grey; the current page's in the accent. */
  .sidebar-nav-item .icon {
    @apply shrink-0 text-[22px] text-ink-2;
  }

  .sidebar-nav-item:hover .icon {
    @apply text-ink;
  }

  .sidebar-nav-item.active .icon {
    @apply text-accent;
  }

  /* Mobile Drawer */
  .mobile-drawer-backdrop {
    @apply fixed inset-0 z-50 bg-ink/60 opacity-0 transition-opacity duration-300;
  }

  .mobile-drawer-backdrop.hidden {
    display: none;
  }

  .mobile-drawer-backdrop.open {
    opacity: 1;
  }

  .mobile-drawer-panel {
    position: fixed;
    inset-block: 0;
    left: 0;
    z-index: 51;
    width: 100%;
    max-width: 20rem;
    transform: translateX(-100%);
    transition: transform 0.3s ease;
  }

  .mobile-drawer-panel.open {
    transform: translateX(0);
  }

  .mobile-drawer-inner {
    @apply flex h-full grow flex-col gap-y-5 overflow-y-auto bg-surface px-5 pb-4;
  }

  .mobile-drawer-header {
    @apply flex h-16 shrink-0 items-center justify-between;
  }

  .mobile-drawer-close {
    @apply -m-2.5 p-2.5 text-ink-3 hover:text-ink cursor-pointer;
  }

  /* Content Wrapper with Header */
  .app-content-wrapper {
    @apply lg:pl-72;
  }

  .app-header {
    @apply sticky top-0 z-40 flex h-16 shrink-0 items-center gap-x-4 border-b border-line bg-surface px-4 sm:gap-x-6 sm:px-6 lg:px-8;
  }

  .header-hamburger {
    @apply -m-2.5 p-2.5 text-ink-2 lg:hidden cursor-pointer;
  }

  .header-hamburger .icon {
    @apply size-6;
  }

  .header-separator {
    @apply h-6 w-px bg-line lg:hidden;
  }

  .header-mobile-logo {
    @apply absolute left-1/2 -translate-x-1/2 flex items-center gap-2 text-ink no-underline lg:hidden;
  }

  .header-mobile-logo-icon {
    @apply h-6 w-6 text-accent;
  }

  .header-mobile-logo-text {
    @apply font-display font-semibold text-ink text-sm;
  }

  /* Profile Dropdown (details/summary — CSS-only) */
  .header-profile-dropdown {
    @apply relative ml-auto;
  }

  .header-profile-btn {
    @apply -m-1.5 flex items-center p-1.5 cursor-pointer;
    list-style: none;
  }

  .header-profile-btn::-webkit-details-marker {
    display: none;
  }

  .header-profile-btn::marker {
    display: none;
    content: '';
  }

  .header-profile-dropdown[open] > .header-profile-btn::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: 40;
    cursor: default;
  }

  .header-profile-avatar {
    @apply size-8 rounded-full bg-surface-2;
  }

  .header-profile-avatar-fallback {
    @apply size-8 rounded-full flex items-center justify-center bg-accent-soft text-accent text-xs font-semibold;
  }

  .header-profile-name {
    @apply hidden lg:flex lg:items-center;
  }

  .header-profile-name span {
    @apply ml-3 text-sm font-semibold leading-6 text-ink;
  }

  .header-profile-name .icon {
    @apply ml-1.5 size-5 text-ink-3;
  }

  .header-dropdown-menu {
    @apply absolute right-0 z-50 mt-2.5 w-52 rounded-ui-lg border border-line bg-surface p-1.5 shadow-[0_8px_24px_rgba(0,0,0,0.12)];
    top: 100%;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-0.25rem);
    transition: opacity 150ms ease-out, transform 150ms ease-out, visibility 150ms;
  }

  .header-profile-dropdown[open] .header-dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .header-dropdown-link {
    @apply flex items-center gap-2.5 rounded-ui px-3 py-2 text-sm text-ink-2 no-underline hover:bg-surface-2 hover:text-ink;
  }

  /* Sign out is a form button: make it look like the links around it. */
  .header-dropdown-form { @apply m-0; }
  button.header-dropdown-link { @apply w-full border-0 bg-transparent text-left cursor-pointer; }

  .header-dropdown-link .icon {
    @apply size-5 text-ink-2;
  }

  .header-dropdown-divider {
    @apply my-1 border-t border-line;
  }

  /* Main Content Area */
  .app-content {
    @apply py-10;
  }

  .app-content-container {
    @apply px-4 sm:px-6 lg:px-8;
    max-width: 80rem;
    margin: 0 auto;
    overflow-x: hidden;
  }

  /* Confirm Modal */
  .confirm-modal-overlay {
    @apply fixed inset-0 z-[1000] flex items-center justify-center p-4;
  }

  .confirm-modal-overlay.hidden {
    display: none;
  }

  .confirm-modal-backdrop {
    @apply absolute inset-0 bg-ink/60;
  }

  .confirm-modal {
    @apply relative z-[1] w-full max-w-[400px] rounded-ui-lg border border-line bg-surface p-8 text-center shadow-[0_20px_40px_rgba(0,0,0,0.18)];
  }

  .confirm-modal-close {
    @apply absolute top-3 right-3 flex size-8 items-center justify-center rounded-ui border-0 bg-transparent text-ink-3 cursor-pointer transition-colors hover:bg-surface-2 hover:text-ink;
  }

  .confirm-modal-icon {
    @apply mx-auto mb-4 flex size-14 items-center justify-center rounded-full;
  }

  .confirm-modal-icon-question {
    @apply bg-accent-soft text-accent;
  }

  .confirm-modal-title {
    @apply mb-2 text-lg font-semibold text-ink;
  }

  .confirm-modal-message {
    @apply text-[0.9375rem] leading-normal text-ink-2;
  }

  .confirm-modal-actions {
    @apply mt-6 flex items-center justify-center gap-3;
  }

  /* Table styles */
  .admin-table-header {
    @apply bg-surface-2 border-b border-line;
  }

  .admin-table-header th {
    @apply text-ink-3 tracking-[0.04em];
  }

  .admin-table-row {
    @apply transition-colors duration-100 hover:bg-surface-2;
  }

  /* Status badges: text on a soft tint of its own colour. */
  .admin-badge {
    @apply inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium;
  }

  .admin-badge-active { @apply bg-success-soft text-success; }
  .admin-badge-suspended,
  .admin-badge-danger { @apply bg-danger-soft text-danger; }
  .admin-badge-pending,
  .admin-badge-warn { @apply bg-warn-soft text-warn; }
  .admin-badge-admin { @apply bg-accent-soft text-accent; }
  .admin-badge-editor,
  .admin-badge-moderator { @apply bg-surface-2 text-ink-2; }

  /* Buttons */
  .admin-btn {
    @apply inline-flex items-center justify-center gap-2 rounded-ui px-4 py-2 text-sm font-medium transition-colors duration-150 cursor-pointer;
  }

  .admin-btn-primary {
    @apply bg-accent text-accent-ink hover:bg-accent/90;
  }

  .admin-btn-secondary {
    @apply border border-line bg-surface text-ink hover:bg-surface-2;
  }

  .admin-btn-danger {
    @apply bg-danger text-white hover:bg-danger/90;
  }

  /* Cards */
  .admin-card {
    @apply rounded-ui-lg border border-line bg-surface shadow-ui;
  }

  .admin-card-header {
    @apply flex items-center gap-3 border-b border-line p-6;
  }

  /* An icon in a soft tint of the accent (or a status colour). */
  .admin-card-icon {
    @apply flex size-11 shrink-0 items-center justify-center rounded-ui-lg bg-accent-soft text-accent;
  }

  .admin-card-icon .material-symbols-outlined,
  .admin-card-icon .icon {
    @apply text-[24px];
  }

  .admin-card-icon-success { @apply bg-success-soft text-success; }
  .admin-card-icon-warn { @apply bg-warn-soft text-warn; }
  .admin-card-icon-danger { @apply bg-danger-soft text-danger; }
  .admin-card-icon-neutral { @apply bg-surface-2 text-ink-2; }

  /* A figure in a status colour (a count of errors, say). */
  .admin-text-success { @apply text-success; }
  .admin-text-warn { @apply text-warn; }
  .admin-text-danger { @apply text-danger; }

  /* Status text in dark mode: the brighter good / caution / bad when the app
     defines them, else the status colour lightened, so it reads on a dark tint. */
  .dark .admin-badge-active,
  .dark .admin-card-icon-success,
  .dark .admin-text-success { color: var(--color-good, color-mix(in srgb, var(--color-success) 55%, white)); }
  .dark .admin-badge-pending,
  .dark .admin-badge-warn,
  .dark .admin-card-icon-warn,
  .dark .admin-text-warn { color: var(--color-caution, color-mix(in srgb, var(--color-warn) 55%, white)); }
  .dark .admin-badge-suspended,
  .dark .admin-badge-danger,
  .dark .admin-card-icon-danger,
  .dark .admin-text-danger { color: var(--color-bad, color-mix(in srgb, var(--color-danger) 55%, white)); }

  .admin-card-body {
    @apply p-6 text-ink;
  }

  /* A switch's knob: white on the track in both themes. */
  .admin-toggle-knob {
    @apply bg-white;
  }

  /* Input styles */
  .admin-input {
    @apply w-full rounded-ui border border-line bg-surface px-3 py-2 text-sm text-ink placeholder:text-ink-3;
  }

  .admin-input:focus {
    @apply outline-none border-accent ring-[3px] ring-accent/20;
  }

  /* Search input with icon */
  .admin-search-input {
    padding-left: 2.5rem;
  }

  /* Stats grid for detail page */
  .admin-stats-grid {
    @apply grid grid-cols-2 gap-4 md:grid-cols-4 lg:grid-cols-7;
  }

  .admin-stat-item {
    text-align: center;
  }

  .admin-stat-value {
    @apply text-2xl font-bold text-ink tabular-nums;
  }

  .admin-stat-label {
    @apply text-xs uppercase tracking-[0.05em] text-ink-3;
  }

  /* Page layouts */
  .auth-page {
    @apply min-h-screen bg-bg;
  }

  .page-header {
    @apply flex h-20 items-center bg-accent;
  }

  .page-header-container {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1rem;
    width: 100%;
  }

  .page-header-title {
    @apply text-xl font-semibold text-accent-ink;
  }

  .page-content {
    max-width: 42rem;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .page-title {
    @apply mb-2 text-2xl font-bold text-ink;
  }

  .page-subtitle {
    @apply mb-6 text-ink-2;
  }

  /* Card title/subtitle - extends admin-card */
  .admin-card-title {
    @apply text-lg font-semibold text-ink;
  }

  .admin-card-subtitle {
    @apply text-sm text-ink-2;
  }

  /* Step indicators */
  .steps {
    @apply flex flex-col gap-6;
  }

  .step-number {
    @apply flex size-6 shrink-0 items-center justify-center rounded-full bg-accent text-accent-ink text-xs font-bold;
  }

  .step-header {
    @apply mb-2 flex items-center gap-2;
  }

  .step-title {
    @apply text-sm font-semibold text-ink;
  }

  .step-content {
    margin-left: 2rem;
  }

  .step-text {
    @apply text-sm text-ink-2;
  }

  .step-text-margin {
    margin-bottom: 0.5rem;
  }

  .step-link {
    @apply font-medium text-accent underline hover:no-underline;
  }

  /* Code blocks */
  .code-section {
    @apply flex flex-col gap-3;
  }

  .code-label {
    @apply mb-1 text-xs font-medium uppercase tracking-[0.05em] text-ink-3;
  }

  .code-block {
    @apply overflow-x-auto rounded-ui bg-surface-2 p-3 text-sm text-ink;
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace;
  }

  /* A terminal: dark in both themes. */
  .code-block-dark {
    background: #111827;
    color: #f3f4f6;
    padding: 1rem;
  }

  .code-inline {
    @apply rounded bg-surface-2 px-1.5 py-0.5 text-xs text-ink;
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace;
  }

  /* Custom Dropdown Component */
  .dropdown-button {
    @apply flex items-center justify-between rounded-ui border border-line bg-surface text-sm text-ink cursor-pointer transition-[border-color,box-shadow] duration-150;
  }

  .dropdown-button:focus {
    @apply outline-none border-accent ring-[3px] ring-accent/20;
  }

  .dropdown-block {
    width: 100%;
    padding: 0.5rem 0.75rem;
  }

  .dropdown-inline {
    padding: 0.375rem 0.625rem;
    font-size: 0.8125rem;
  }

  .dropdown-chevron {
    @apply ml-2 shrink-0 text-ink-3;
  }

  .dropdown-options {
    @apply absolute z-50 mt-1 w-full min-w-48 max-h-64 overflow-y-auto rounded-ui-lg border border-line bg-surface p-1 shadow-[0_8px_24px_rgba(0,0,0,0.12)];
  }

  .dropdown-option {
    @apply flex items-center justify-between rounded-ui px-3 py-2 text-sm text-ink-2 cursor-pointer transition-colors duration-100;
  }

  .dropdown-option:hover,
  .dropdown-option-focused {
    @apply bg-surface-2 text-ink;
  }

  .dropdown-option-selected {
    @apply font-medium text-ink;
  }

  .dropdown-check {
    @apply ml-2 shrink-0 text-accent;
  }

  /* Page loader spinner - pure CSS, no font dependency */
  .spinner {
    @apply size-8 rounded-full border-[3px] border-line border-t-accent;
    animation: spin 0.8s linear infinite;
  }

  .spinner-sm {
    @apply size-4 border-2;
  }

  .spinner-lg {
    @apply size-12 border-4;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* Admin chart container */
  .admin-chart-container {
    height: 250px;
  }

  /* The element ECharts renders into. It needs explicit dimensions at
     init time, which is why this is a class and not left to the parent. */
  .admin-chart-canvas {
    width: 100%;
    height: 100%;
  }
}

/* Admin pages written with Tailwind's greys (an app's own admin pages, say)
   follow the tokens too, in both themes. Outside @layer so they win over the
   utilities themselves. */
.admin-content .bg-white { background-color: var(--color-surface); }
.admin-content .bg-gray-50,
.admin-content .bg-gray-100 { background-color: var(--color-surface-2); }
.admin-content .text-gray-900,
.admin-content .text-gray-800 { color: var(--color-ink); }
.admin-content .text-gray-700,
.admin-content .text-gray-600 { color: var(--color-ink-2); }
.admin-content .text-gray-500,
.admin-content .text-gray-400 { color: var(--color-ink-3); }
.admin-content .border-gray-100,
.admin-content .border-gray-200,
.admin-content .border-gray-300 { border-color: var(--color-line); }
.admin-content .divide-gray-200 > * + * { border-color: var(--color-line); }
.admin-content .hover\:bg-gray-50:hover { background-color: var(--color-surface-2); }

/* Tables: a line between rows and a tint on hover, no stripes. */
.admin-content tbody tr { border-bottom: 1px solid var(--color-line); }
.admin-content tbody tr:last-child { border-bottom: none; }
.admin-content tbody tr:hover { background: var(--color-surface-2); }
.admin-content .divide-y > * + * { border-top-width: 0; }

/* Form fields inside admin pages. */
.admin-content select,
.admin-content textarea,
.admin-content input:not([type="checkbox"]):not([type="radio"]) {
  background-color: var(--color-surface);
  color: var(--color-ink);
  border-color: var(--color-line);
}
.admin-content input::placeholder,
.admin-content textarea::placeholder { color: var(--color-ink-3); }
.admin-content input:focus,
.admin-content textarea:focus,
.admin-content select:focus {
  border-color: var(--color-accent);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 20%, transparent);
  outline: none;
}

/* The shadows read as nothing on a dark surface: a hairline instead. */
.dark .admin-card,
.dark .admin-content .shadow,
.dark .admin-content .shadow-lg,
.dark .admin-content .shadow-xl { box-shadow: none; border: 1px solid var(--color-line); }

/* Add your custom styles below */
