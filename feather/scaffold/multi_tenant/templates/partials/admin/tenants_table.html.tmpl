<div class="admin-card overflow-hidden">
    <table class="w-full">
        <thead class="admin-table-header">
            <tr>
                <th class="px-4 py-3 text-left text-xs font-medium text-ink-2 uppercase">Tenant</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-ink-2 uppercase">Domain</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-ink-2 uppercase">Users</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-ink-2 uppercase">Status</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-ink-2 uppercase">Created</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-line">
            {% for tenant in tenants %}
            <tr class="hover:bg-surface-2 cursor-pointer"
                data-href="{{ url_for('admin.tenant_detail_page', tenant_id=tenant.id) }}">
                <td class="px-4 py-3">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-lg bg-surface-2 flex items-center justify-center">
                            <span class="material-symbols-outlined text-ink-2">business</span>
                        </div>
                        <div>
                            <p class="font-medium">{{ tenant.name }}</p>
                            <p class="text-sm text-ink-2">{{ tenant.slug }}</p>
                        </div>
                    </div>
                </td>
                <td class="px-4 py-3 text-sm text-ink-2">{{ tenant.domain }}</td>
                <td class="px-4 py-3 text-sm text-ink-2">{{ tenant.user_count if tenant.user_count is defined else '-' }}</td>
                <td class="px-4 py-3">
                    {% if tenant.status == 'active' %}
                    <span class="admin-badge admin-badge-active">Active</span>
                    {% elif tenant.status == 'pending' %}
                    <span class="admin-badge admin-badge-warn">Pending</span>
                    {% else %}
                    <span class="admin-badge admin-badge-danger">Suspended</span>
                    {% endif %}
                </td>
                <td class="px-4 py-3 text-sm text-ink-2">{{ tenant.created_at.strftime('%b %d, %Y') }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    {% if not tenants %}
    <div class="p-8 text-center text-ink-3">
        <span class="material-symbols-outlined text-4xl mb-2">business</span>
        <p class="text-sm">No tenants found</p>
    </div>
    {% endif %}
</div>

<!-- Pagination -->
{% if pagination.pages > 1 %}
<div class="flex items-center justify-between mt-4">
    <div class="text-sm text-ink-2">
        Showing {{ pagination.start }}-{{ pagination.end }} of {{ pagination.total }}
    </div>
    <div class="flex gap-2">
        {% if pagination.has_prev %}
        <a href="?page={{ pagination.page - 1 }}{% if status_filter %}&status={{ status_filter }}{% endif %}"
           class="px-4 py-2 text-sm bg-surface border border-line rounded hover:bg-surface-2">
            Previous
        </a>
        {% else %}
        <button disabled class="px-4 py-2 text-sm bg-surface border border-line rounded opacity-50 cursor-not-allowed">
            Previous
        </button>
        {% endif %}
        {% if pagination.has_next %}
        <a href="?page={{ pagination.page + 1 }}{% if status_filter %}&status={{ status_filter }}{% endif %}"
           class="px-4 py-2 text-sm bg-surface border border-line rounded hover:bg-surface-2">
            Next
        </a>
        {% else %}
        <button disabled class="px-4 py-2 text-sm bg-surface border border-line rounded opacity-50 cursor-not-allowed">
            Next
        </button>
        {% endif %}
    </div>
</div>
{% endif %}
