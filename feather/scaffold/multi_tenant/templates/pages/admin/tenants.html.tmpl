{% extends "pages/admin/base.html" %}

{% block admin_content %}
<div class="space-y-6">
    <!-- Header with Create Button -->
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-2xl font-semibold text-ink">Tenants</h2>
            <p class="text-sm text-ink-2">Manage organizations in the platform</p>
        </div>
        <button data-action="show-create-tenant"
                class="admin-btn admin-btn-primary">
            <span class="material-symbols-outlined text-sm align-middle mr-1">add</span>
            New Tenant
        </button>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div class="admin-card p-6">
            <div class="flex items-center gap-3">
                <div class="admin-card-icon">
                    <span class="material-symbols-outlined">business</span>
                </div>
                <div>
                    <p class="text-2xl font-semibold">{{ stats.total }}</p>
                    <p class="text-sm text-ink-2">Total Tenants</p>
                </div>
            </div>
        </div>
        <div class="admin-card p-6">
            <div class="flex items-center gap-3">
                <div class="admin-card-icon admin-card-icon-success">
                    <span class="material-symbols-outlined">check_circle</span>
                </div>
                <div>
                    <p class="text-2xl font-semibold">{{ stats.active }}</p>
                    <p class="text-sm text-ink-2">Active</p>
                </div>
            </div>
        </div>
        <div class="admin-card p-6">
            <div class="flex items-center gap-3">
                <div class="admin-card-icon admin-card-icon-warn">
                    <span class="material-symbols-outlined">schedule</span>
                </div>
                <div>
                    <p class="text-2xl font-semibold">{{ stats.pending }}</p>
                    <p class="text-sm text-ink-2">Pending</p>
                </div>
            </div>
        </div>
        <div class="admin-card p-6">
            <div class="flex items-center gap-3">
                <div class="admin-card-icon admin-card-icon-danger">
                    <span class="material-symbols-outlined">block</span>
                </div>
                <div>
                    <p class="text-2xl font-semibold">{{ stats.suspended }}</p>
                    <p class="text-sm text-ink-2">Suspended</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Status Filter -->
    <div class="flex items-center gap-2">
        <span class="text-sm text-ink-2">Filter:</span>
        <a href="{{ url_for('admin.tenants_page') }}"
           class="px-3 py-1.5 text-sm rounded-lg {% if not status_filter %}bg-accent text-accent-ink{% else %}bg-surface-2 text-ink-2 hover:bg-line{% endif %}">
            All
        </a>
        <a href="{{ url_for('admin.tenants_page', status='active') }}"
           class="px-3 py-1.5 text-sm rounded-lg {% if status_filter == 'active' %}bg-accent text-accent-ink{% else %}bg-surface-2 text-ink-2 hover:bg-line{% endif %}">
            Active
        </a>
        <a href="{{ url_for('admin.tenants_page', status='pending') }}"
           class="px-3 py-1.5 text-sm rounded-lg {% if status_filter == 'pending' %}bg-accent text-accent-ink{% else %}bg-surface-2 text-ink-2 hover:bg-line{% endif %}">
            Pending
        </a>
        <a href="{{ url_for('admin.tenants_page', status='suspended') }}"
           class="px-3 py-1.5 text-sm rounded-lg {% if status_filter == 'suspended' %}bg-accent text-accent-ink{% else %}bg-surface-2 text-ink-2 hover:bg-line{% endif %}">
            Suspended
        </a>
    </div>

    <!-- Tenants Table -->
    <div id="tenants-table-container">
        {% include "partials/admin/tenants_table.html" %}
    </div>
</div>

<!-- Create Tenant Modal -->
<div id="create-tenant-modal" class="hidden fixed inset-0 z-50 overflow-y-auto">
    <div class="flex items-center justify-center min-h-screen px-4">
        <div class="fixed inset-0 bg-ink/60" data-action="hide-create-tenant"></div>
        <div class="relative bg-surface rounded-lg shadow-xl max-w-md w-full p-6">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-semibold text-ink">Create New Tenant</h3>
                <button data-action="hide-create-tenant"
                        class="text-ink-3 hover:text-ink-2">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <form action="{{ url_for('admin.create_tenant') }}" method="POST" class="space-y-4">
                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">

                <div>
                    <label class="block text-sm font-medium text-ink-2 mb-1">Tenant Name</label>
                    <input type="text" name="name" required
                           placeholder="Acme Corporation"
                           class="w-full px-3 py-2 border border-line rounded-lg focus:outline-none focus:ring-2 focus:ring-accent">
                </div>

                <div>
                    <label class="block text-sm font-medium text-ink-2 mb-1">Email Domain</label>
                    <input type="text" name="domain" required
                           placeholder="acme.com"
                           class="w-full px-3 py-2 border border-line rounded-lg focus:outline-none focus:ring-2 focus:ring-accent">
                    <p class="text-xs text-ink-3 mt-1">Users with this email domain can join</p>
                </div>

                <div>
                    <label class="block text-sm font-medium text-ink-2 mb-1">Admin Email</label>
                    <input type="email" name="admin_email" required
                           placeholder="admin@acme.com"
                           class="w-full px-3 py-2 border border-line rounded-lg focus:outline-none focus:ring-2 focus:ring-accent">
                    <p class="text-xs text-ink-3 mt-1">This user will be the tenant admin</p>
                </div>

                <div class="flex justify-end gap-3 pt-4">
                    <button type="button"
                            data-action="hide-create-tenant"
                            class="admin-btn admin-btn-secondary">
                        Cancel
                    </button>
                    <button type="submit"
                            class="admin-btn admin-btn-primary">
                        Create Tenant
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
