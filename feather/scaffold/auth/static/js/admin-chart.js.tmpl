/**
 * Admin Analytics Chart
 * ======================
 * ECharts rendering for user growth analytics.
 */

(function() {
  "use strict";

  var container = document.getElementById("chart-container");
  var chartEl = document.getElementById("user-growth-chart");
  var chart = null;
  var lastData = null;

  // The design tokens (ui.css), so the chart matches the app in either theme.
  function token(name) {
    return getComputedStyle(document.documentElement).getPropertyValue(name).trim();
  }

  // A #rrggbb token as rgba, for the area under the line.
  function translucent(hex, alpha) {
    var m = /^#?([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})$/i.exec(hex);
    if (!m) return hex;
    return "rgba(" + parseInt(m[1], 16) + ", " + parseInt(m[2], 16) + ", " + parseInt(m[3], 16) + ", " + alpha + ")";
  }

  function themeColors() {
    var accent = token("--color-accent");
    return {
      text: token("--color-ink-3"),
      line: accent,
      area: translucent(accent, 0.12),
      splitLine: token("--color-line"),
      font: getComputedStyle(document.body).fontFamily
    };
  }

  async function loadAndRender(days) {
    if (!container) return;
    var apiUrl = container.dataset.apiUrl;
    if (!apiUrl) return;

    try {
      var result = await ApiUtility.get(apiUrl + "?days=" + days);
      if (result.success && result.data) {
        renderChart(result.data);
      }
    } catch (error) {
      console.error("Failed to load user growth data:", error);
    }
  }

  // vendor.js loads ECharts only on a page with a [data-echarts] element,
  // and as a module it runs after this script: wait for it. It has started
  // by DOMContentLoaded.
  function echartsLoaded() {
    if (window.echartsReady) return window.echartsReady;
    return new Promise(function(resolve) {
      document.addEventListener("DOMContentLoaded", function() { resolve(window.echartsReady); }, { once: true });
    });
  }

  async function renderChart(data) {
    if (!chartEl) return;
    lastData = data;
    var echarts = await echartsLoaded();
    if (!echarts) return;
    if (chart) chart.dispose();

    chart = echarts.init(chartEl);
    var colors = themeColors();

    chart.setOption({
      textStyle: { fontFamily: colors.font },
      tooltip: { trigger: "axis" },
      grid: { left: 40, right: 20, top: 20, bottom: 30 },
      xAxis: {
        type: "category",
        data: data.map(function(d) {
          return new Date(d.date).toLocaleDateString("en-US", { month: "short", day: "numeric" });
        }),
        axisLabel: { color: colors.text },
        axisLine: { lineStyle: { color: colors.splitLine } }
      },
      yAxis: {
        type: "value",
        minInterval: 1,
        axisLabel: { color: colors.text },
        splitLine: { lineStyle: { color: colors.splitLine } }
      },
      series: [{
        type: "line",
        data: data.map(function(d) { return d.count; }),
        smooth: true,
        lineStyle: { color: colors.line },
        itemStyle: { color: colors.line },
        areaStyle: { color: colors.area }
      }]
    });
  }

  window.addEventListener("resize", function() {
    if (chart) chart.resize();
  });

  // Redraw in the other theme's colours when light and dark are switched.
  new MutationObserver(function() {
    if (lastData) renderChart(lastData);
  }).observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });

  document.addEventListener("DOMContentLoaded", function() {
    var selector = document.getElementById("time-range-select");
    if (selector) {
      selector.addEventListener("change", function(e) {
        loadAndRender(parseInt(e.target.value));
      });
    }
    loadAndRender(30);
  });
})();
